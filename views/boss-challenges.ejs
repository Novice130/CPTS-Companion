  <!-- Challenge 10 -->
  <div class="challenge-card" id="c10">
    <div class="challenge-header" onclick="toggleChallenge('c10')">
      <span class="challenge-num">BOSS-10</span>
      <span class="challenge-title">The Full Chain: External to DA</span>
      <div class="challenge-badges">
        <span class="badge badge-diff expert">Expert</span>
        <span class="badge badge-cat">Full Chain · All Skills</span>
      </div>
