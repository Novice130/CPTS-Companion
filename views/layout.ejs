<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' | ' : (typeof title !== 'undefined' ? title + ' | ' : '') %>CPTS Companion</title>
  <meta name="description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : 'The definitive HTB CPTS study companion — 40 modules, interactive exercises, flashcards, mind maps, and a full report writing course. Pass CPTS in 30 days.' %>">
  <meta name="keywords" content="CPTS, HTB CPTS, HackTheBox, penetration testing, cybersecurity certification, CPTS study guide, Active Directory, privilege escalation">
  <meta name="author" content="CPTS Companion — cpts.learnnovice.com">
  <meta name="robots" content="index, follow">
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://cpts.learnnovice.com<%= typeof ogPath !== 'undefined' ? ogPath : '' %>">
  <meta property="og:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle + ' | CPTS Companion' : 'CPTS Companion — HTB CPTS Study Platform' %>">
  <meta property="og:description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : 'The definitive HTB CPTS study companion. Interactive exercises, flashcards, mind maps, and gamified learning for penetration testing certification.' %>">
  <meta property="og:image" content="https://cpts.learnnovice.com/img/og-card.jpg">
  <meta property="og:site_name" content="CPTS Companion">
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@learnnovice">
  <meta name="twitter:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle + ' | CPTS Companion' : 'CPTS Companion' %>">
  <meta name="twitter:description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : 'Study for HTB CPTS with interactive exercises, flashcards, and gamified modules.' %>">
  <meta name="twitter:image" content="https://cpts.learnnovice.com/img/og-card.jpg">
  <!-- Canonical -->
  <link rel="canonical" href="https://cpts.learnnovice.com<%= typeof ogPath !== 'undefined' ? ogPath : '' %>">
  <link rel="icon" type="image/jpeg" href="/favicon.jpg">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
</head>
<body class="scanlines">
  <div class="app-container">
    <!-- Sidebar -->
    <aside class="sidebar">
      <a class="sidebar-logo" href="https://learnnovice.com" target="_blank" rel="noopener noreferrer">
        <div class="logo-icon logo-image">
          <img class="logo-img" src="/img/logo.jpg" alt="Logo">
        </div>
        <div class="logo-text">CPTS <span>Companion</span></div>
      </a>
      
      <nav class="sidebar-nav">
        <div class="nav-section">
          <div class="nav-section-title">Main</div>
          <a href="/" class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'dashboard' ? 'active' : '' %>">
            <span class="nav-icon">⌂</span>
            Dashboard
          </a>
          <a href="/plan" class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'plan' ? 'active' : '' %>">
            <span class="nav-icon">📅</span>
            30-Day Plan
            <% if (typeof stats !== 'undefined') { %>
              <span class="nav-badge"><%= stats.completedDays %>/30</span>
            <% } %>
          </a>
        </div>
        
        <div class="nav-section">
          <div class="nav-section-title">Learn</div>
          <a href="/modules" class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'modules' ? 'active' : '' %>">
            <span class="nav-icon">📚</span>
            Modules
          </a>
          <a href="/exercises" class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'exercises' ? 'active' : '' %>">
            <span class="nav-icon">🎯</span>
            Exercises
            <% if (typeof stats !== 'undefined') { %>
              <span class="nav-badge"><%= stats.completedExercises %>/<%= stats.totalExercises %></span>
            <% } %>
          </a>
          <a href="/flashcards" class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'flashcards' ? 'active' : '' %>">
            <span class="nav-icon">🃏</span>
            Flashcards
            <% if (typeof dueCount !== 'undefined' && dueCount > 0) { %>
              <span class="nav-badge"><%= dueCount %> due</span>
            <% } %>
          </a>
          <a href="/mindmaps" class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'mindmaps' ? 'active' : '' %>">
            <span class="nav-icon">🗺️</span>
            Mind Maps
          </a>
          <a href="/explore" class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'explore' ? 'active' : '' %>">
            <span class="nav-icon">🧭</span>
            Explore Map
          </a>
          <a href="/report-course" class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'report-course' ? 'active' : '' %>">
            <span class="nav-icon">📝</span>
            Report Course
          </a>
          <a href="/path" class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'path' ? 'active' : '' %>">
            <span class="nav-icon">🗺️</span>
            CPTS Path
          </a>
        </div>

        <div class="nav-section">
          <div class="nav-section-title">Practice</div>
          <a href="/challenges" class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'challenges' ? 'active' : '' %>">
            <span class="nav-icon">⚔️</span>
            Boss Challenges
          </a>
          <a href="/mock-exam" class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'mock-exam' ? 'active' : '' %>">
            <span class="nav-icon">🎓</span>
            Mock Exam
          </a>
          <a href="/research" class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'research' ? 'active' : '' %>">
            <span class="nav-icon">🔬</span>
            Research Hub
          </a>
        </div>

        <div class="nav-section">
          <div class="nav-section-title">Community</div>
          <a href="/exam-tips" class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'exam-tips' ? 'active' : '' %>">
            <span class="nav-icon">💡</span>
            Exam Tips
          </a>
          <a href="/hall-of-fame" class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'hall-of-fame' ? 'active' : '' %>">
            <span class="nav-icon">🏆</span>
            Hall of Fame
          </a>
        </div>

        <div class="nav-section">
          <div class="nav-section-title">Tools</div>
          <a href="/notes" class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'notes' ? 'active' : '' %>">
            <span class="nav-icon">📝</span>
            Notes
          </a>
          <a href="/search" class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'search' ? 'active' : '' %>">
            <span class="nav-icon">🔍</span>
            Search
          </a>
          <a href="/settings" class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'settings' ? 'active' : '' %>">
            <span class="nav-icon">⚙️</span>
            Settings
          </a>
        </div>
      </nav>
      
      <div style="padding: 1rem; border-top: 1px solid var(--htb-border); font-size: 0.75rem; color: var(--text-muted);">
        ⚠️ Educational use only<br>
        Authorized labs only!
      </div>
    </aside>
    
    <!-- Main Content Wrapper -->
    <div class="main-wrapper">
      <!-- Top Bar -->
      <header class="topbar">
        <div class="topbar-stats">
          <div class="stat-item">
            <span class="stat-icon">📊</span>
            <span class="stat-label">Progress</span>
            <span class="stat-value"><%= typeof stats !== 'undefined' ? stats.overallProgress : 0 %>%</span>
          </div>
          <div class="stat-item">
            <span class="stat-icon">✅</span>
            <span class="stat-label">Exercises</span>
            <span class="stat-value"><%= typeof stats !== 'undefined' ? stats.completedExercises : 0 %></span>
          </div>
          <div class="stat-item">
            <span class="stat-icon">🔄</span>
            <span class="stat-label">Review</span>
            <span class="stat-value"><%= typeof nextReview !== 'undefined' ? nextReview : 'None' %></span>
          </div>
        </div>
        
        <div class="topbar-actions">
          <button class="cmd-palette-btn" onclick="openCommandPalette()">
            <span>🔍</span>
            Quick search...
            <kbd>Ctrl</kbd><kbd>K</kbd>
          </button>
          <% if (typeof user !== 'undefined' && user) { %>
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-left: 1rem; padding-left: 1rem; border-left: 1px solid var(--htb-border);">
              <span style="color: var(--text-muted); font-size: 0.85rem;">
                👤 <span style="color: var(--htb-green); font-weight: 600;"><%= user.name || user.email %></span>
              </span>
              <a href="/logout" style="color: var(--text-muted); font-size: 0.8rem; text-decoration: none; padding: 4px 10px; border: 1px solid var(--htb-border); border-radius: 6px; transition: all 0.2s;" onmouseover="this.style.borderColor='var(--htb-red)';this.style.color='var(--htb-red)'" onmouseout="this.style.borderColor='var(--htb-border)';this.style.color='var(--text-muted)'" >Logout</a>
            </div>
          <% } %>
        </div>
      </header>
      <%- include('partials/login-prompt', { user: typeof user !== 'undefined' ? user : null }) %>
      
      <!-- Page Content -->
      <main class="main-content">
        <%- body %>
      </main>
    </div>
  </div>
  
  <!-- Command Palette -->
  <div class="cmd-palette-overlay" id="cmdPalette">
    <div class="cmd-palette">
      <input type="text" class="cmd-palette-input" id="cmdPaletteInput" placeholder="Search pages, modules, exercises..." autofocus>
      <div class="cmd-palette-results" id="cmdPaletteResults"></div>
    </div>
  </div>
  
  <script src="/js/app.js"></script>
</body>
</html>
