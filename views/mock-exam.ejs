<script>
function toggleDay(id) {
  const card = document.getElementById(id);
  card.classList.toggle('open');
}

const timers = {};
function startTimer(id, hours) {
  if (timers[id]) { clearInterval(timers[id]); delete timers[id]; return; }
  const el = document.getElementById(id);
  let total = parseFloat(el.dataset.remaining || (hours ? hours * 3600 : el.textContent.split(':').reduce((acc,t,i) => acc + parseInt(t) * [3600,60,1][i], 0)));
  el.dataset.remaining = total;
  timers[id] = setInterval(() => {
    total = Math.max(0, total - 1);
    el.dataset.remaining = total;
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    const s = total % 60;
    el.textContent = `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
    if (total === 0) { clearInterval(timers[id]); delete timers[id]; el.style.color = '#f43f5e'; }
  }, 1000);
}
function resetTimer(id, hours) {
  if (timers[id]) { clearInterval(timers[id]); delete timers[id]; }
  const el = document.getElementById(id);
  el.style.color = 'var(--htb-green)';
  el.dataset.remaining = hours * 3600;
  el.textContent = `0${hours}:00:00`;
}
</script>
