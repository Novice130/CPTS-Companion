<% const pageTitle = 'Mock Exam Simulator'; %>
<% const metaDesc = '5 CPTS mock exam simulation days with hour-by-hour schedules, 10-machine scenarios, and timed methodology to prepare for the real 10-day exam.'; %>
<% const ogPath = '/mock-exam'; %>


<style>
.exam-hero { background: var(--htb-surface); border: 1px solid rgba(244,63,94,0.4); border-radius: 12px; padding: 1.5rem; margin-bottom: 2rem; }
.exam-hero-title { font-family: var(--font-mono); font-size: 1rem; color: #f43f5e; margin-bottom: 0.5rem; }
.exam-hero-text { font-size: 0.82rem; color: var(--text-muted); line-height: 1.6; }
.exam-rules { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.75rem; margin: 1rem 0; }
.rule-item { background: var(--htb-bg); border: 1px solid var(--htb-border); border-radius: 8px; padding: 0.75rem; font-size: 0.78rem; color: var(--text-secondary); }
.rule-item strong { display: block; color: var(--htb-green); font-family: var(--font-mono); margin-bottom: 0.25rem; font-size: 0.72rem; }
.day-grid { display: grid; gap: 1.25rem; }
.day-card { background: var(--htb-surface); border: 1px solid var(--htb-border); border-radius: 10px; overflow: hidden; }
.day-card.active-day { border-color: var(--htb-green); }
.day-header { padding: 1.25rem 1.5rem; cursor: pointer; display: flex; align-items: center; gap: 1rem; transition: background 0.15s; }
.day-header:hover { background: rgba(127,209,100,0.04); }
.day-num { font-family: var(--font-mono); font-size: 1.1rem; font-weight: 700; color: var(--htb-green); min-width: 80px; }
.day-title { flex: 1; }
.day-title-main { font-size: 0.95rem; font-weight: 700; color: var(--text-primary); }
.day-title-sub { font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono); margin-top: 0.2rem; }
.day-meta { display: flex; gap: 0.5rem; flex-shrink: 0; }
.meta-pill { font-size: 0.65rem; font-family: var(--font-mono); padding: 2px 8px; border-radius: 4px; }
.mp-duration { background: rgba(127,209,100,0.1); color: var(--htb-green); border: 1px solid rgba(127,209,100,0.3); }
.mp-boxes { background: rgba(96,165,250,0.1); color: #60a5fa; border: 1px solid rgba(96,165,250,0.3); }
.day-chevron { color: var(--text-muted); font-size: 0.75rem; transition: transform 0.2s; flex-shrink: 0; }
.day-card.open .day-chevron { transform: rotate(90deg); }
.day-body { display: none; border-top: 1px solid var(--htb-border); }
.day-card.open .day-body { display: block; }
.day-layout { display: grid; grid-template-columns: 1fr 280px; gap: 0; }
.schedule-col { padding: 1.5rem; border-right: 1px solid var(--htb-border); }
.targets-col { padding: 1.5rem; }
.schedule-title { font-family: var(--font-mono); font-size: 0.72rem; color: var(--htb-green); margin-bottom: 1rem; }
.time-block { display: flex; gap: 0.75rem; margin-bottom: 1rem; align-items: flex-start; }
.time-label { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted); min-width: 80px; padding-top: 0.15rem; flex-shrink: 0; }
.time-content { flex: 1; }
.time-content-title { font-size: 0.82rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.25rem; }
.time-content-detail { font-size: 0.76rem; color: var(--text-muted); line-height: 1.5; }
.time-content-cmd { background: var(--htb-bg); border: 1px solid var(--htb-border); border-radius: 4px; padding: 4px 8px; font-family: var(--font-mono); font-size: 0.72rem; color: var(--htb-green); margin-top: 0.35rem; display: block; overflow-x: auto; white-space: nowrap; }
.time-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--htb-border); flex-shrink: 0; margin-top: 0.4rem; }
.time-dot.active { background: var(--htb-green); }
.time-dot.warn { background: #fb923c; }
.time-dot.crit { background: #f43f5e; }
.target-box { background: var(--htb-bg); border: 1px solid var(--htb-border); border-radius: 8px; padding: 1rem; margin-bottom: 0.75rem; }
.target-ip { font-family: var(--font-mono); font-size: 0.82rem; color: var(--htb-green); font-weight: 700; }
.target-name { font-size: 0.75rem; color: var(--text-primary); font-weight: 600; margin: 0.2rem 0; }
.target-detail { font-size: 0.7rem; color: var(--text-muted); line-height: 1.4; }
.target-flags { display: flex; gap: 0.3rem; flex-wrap: wrap; margin-top: 0.4rem; }
.target-flag { font-size: 0.6rem; font-family: var(--font-mono); padding: 1px 5px; border-radius: 3px; background: rgba(127,209,100,0.1); color: var(--htb-green); border: 1px solid rgba(127,209,100,0.2); }
.checklist { margin: 1rem 0; }
.check-item { display: flex; align-items: center; gap: 0.5rem; font-size: 0.78rem; color: var(--text-secondary); padding: 0.3rem 0; }
.check-item input[type=checkbox] { accent-color: var(--htb-green); width: 14px; height: 14px; cursor: pointer; }
.timer-display { background: var(--htb-bg); border: 1px solid var(--htb-border); border-radius: 8px; padding: 1rem; margin-bottom: 1rem; text-align: center; }
.timer-value { font-family: var(--font-mono); font-size: 1.5rem; font-weight: 700; color: var(--htb-green); }
.timer-label { font-size: 0.65rem; color: var(--text-muted); font-family: var(--font-mono); margin-top: 0.25rem; }
.timer-btns { display: flex; gap: 0.4rem; justify-content: center; margin-top: 0.5rem; }
.timer-btn { font-size: 0.7rem; padding: 4px 10px; border: 1px solid var(--htb-border); border-radius: 4px; background: transparent; color: var(--text-muted); cursor: pointer; font-family: var(--font-mono); }
.timer-btn:hover { border-color: var(--htb-green); color: var(--htb-green); }
@media (max-width: 800px) { .day-layout { grid-template-columns: 1fr; } .schedule-col { border-right: none; border-bottom: 1px solid var(--htb-border); } }
</style>

<div class="page-header" style="margin-bottom:1.5rem;">
  <h1 class="page-title"><span style="color:var(--htb-green)">></span> Mock Exam Simulator</h1>
  <p class="page-subtitle">5 full-day exam simulations with hour-by-hour schedules and realistic 10-box AD scenarios. Train your methodology, not just your tools.</p>
</div>

<div class="exam-hero">
  <div class="exam-hero-title">🎯 MOCK EXAM LAB GUIDE — How to Practice with Real HTB & TryHackMe Rooms</div>
  <div class="exam-hero-text">
    <strong>💡 How This Simulator Works:</strong>
    CPTS is a hands-on, multi-subnet penetration testing exam. Our platform provides the <strong>5-day methodology framework, hour-by-hour schedules, timing benchmarks, and attack flowcharts</strong>.
    <br><br>
    For live, hands-on target practice, connect your Kali to <strong>Hack The Box (HTB)</strong> and <strong>TryHackMe (THM)</strong> to spawn the recommended rooms mapped below:
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; margin-top: 1rem;">
      <div style="background: var(--htb-bg); border: 1px solid var(--htb-border); border-radius: 8px; padding: 1rem;">
        <div style="color: var(--htb-green); font-weight: 700; font-size: 0.85rem; margin-bottom: 0.5rem;">🟢 Hack The Box (HTB) Boxes & Labs</div>
        <ul style="margin: 0; padding-left: 1.2rem; font-size: 0.78rem; color: var(--text-secondary); line-height: 1.6;">
          <li><strong>Web & Footholds:</strong> <em>Sau</em>, <em>Pilgrimage</em>, <em>Keeper</em>, <em>Delivery</em></li>
          <li><strong>Active Directory:</strong> <em>Forest</em>, <em>Active</em>, <em>Resolute</em>, <em>Cascade</em>, <em>Monteverde</em></li>
          <li><strong>ProLabs & Skills Assessments:</strong> <em>Dante ProLab</em>, <em>Zephyr ProLab</em>, <em>HTB Academy CPTS Assessment</em></li>
        </ul>
      </div>

      <div style="background: var(--htb-bg); border: 1px solid var(--htb-border); border-radius: 8px; padding: 1rem;">
        <div style="color: #60a5fa; font-weight: 700; font-size: 0.85rem; margin-bottom: 0.5rem;">🔵 TryHackMe (THM) Networks & Rooms</div>
        <ul style="margin: 0; padding-left: 1.2rem; font-size: 0.78rem; color: var(--text-secondary); line-height: 1.6;">
          <li><strong>Multi-Hop Pivoting:</strong> <em>Wreath Network</em> (Chisel, Socat, Proxychains, Pivoting)</li>
          <li><strong>Active Directory:</strong> <em>Attacktive Directory</em>, <em>Holo Network</em>, <em>Throwback</em></li>
          <li><strong>Privilege Escalation:</strong> <em>Linux/Windows PrivEsc Arena</em>, <em>Buffer Overflow Prep</em></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="exam-rules" style="margin-top: 1.25rem;">
    <div class="rule-item"><strong>// Duration</strong>Each sim day = 8 focused hours. Take 1 hour off after hour 4.</div>
    <div class="rule-item"><strong>// Documentation</strong>Screenshot every compromise. Note timestamps. Write findings as you go, not at the end.</div>
    <div class="rule-item"><strong>// Tools Allowed</strong>Same as real exam: Kali tools, custom scripts, HTB/THM VPN access.</div>
    <div class="rule-item"><strong>// Reporting Course</strong>Draft your final 20+ page exam report using our built-in <a href="/report-course" style="color:var(--htb-green); text-decoration:underline;">Report Course</a>.</div>
  </div>
</div>

<div class="day-grid">

  <!-- DAY 1 -->
  <div class="day-card" id="day1">
    <div class="day-header" onclick="toggleDay('day1')">
      <span class="day-num">DAY 1</span>
      <div class="day-title">
        <div class="day-title-main">Enumeration Blitz</div>
        <div class="day-title-sub">Focus: External recon → Web foothold → Linux privesc</div>
      </div>
      <div class="day-meta">
        <span class="meta-pill mp-duration">8 hours</span>
        <span class="meta-pill mp-boxes">4 targets</span>
      </div>
      <span class="day-chevron">▶</span>
    </div>
    <div class="day-body">
      <div class="day-layout">
        <div class="schedule-col">
          <div class="schedule-title">// HOUR-BY-HOUR SCHEDULE</div>
          <div class="time-block">
            <div class="time-dot active"></div>
            <span class="time-label">H1: 0:00–1:00</span>
            <div class="time-content">
              <div class="time-content-title">Full Network Scan</div>
              <div class="time-content-detail">Nmap all 4 targets. Document all open ports, services, OS. Do NOT start exploitation yet.</div>
              <code class="time-content-cmd">nmap -sC -sV -p- --open -T4 -oA initial 10.10.10.0/24</code>
            </div>
          </div>
          <div class="time-block">
            <div class="time-dot active"></div>
            <span class="time-label">H2: 1:00–2:00</span>
            <div class="time-content">
              <div class="time-content-title">Web Enumeration</div>
              <div class="time-content-detail">Fuzz all HTTP/HTTPS services. Identify tech stack, CMS, hidden directories, parameters.</div>
              <code class="time-content-cmd">ffuf -w /usr/share/seclists/Discovery/Web-Content/raft-medium-directories.txt -u http://TARGET/FUZZ</code>
            </div>
          </div>
          <div class="time-block">
            <div class="time-dot active"></div>
            <span class="time-label">H3-4: 2:00–4:00</span>
            <div class="time-content">
              <div class="time-content-title">Exploitation Window #1</div>
              <div class="time-content-detail">Attack the easiest web target. Get initial foothold. Enumerate local system post-compromise.</div>
            </div>
          </div>
          <div class="time-block">
            <div class="time-dot warn"></div>
            <span class="time-label">H5: 4:00–5:00</span>
            <div class="time-content">
              <div class="time-content-title">BREAK + Documentation</div>
              <div class="time-content-detail">Step away 30 min. Return and write up what you've found so far in report format.</div>
            </div>
          </div>
          <div class="time-block">
            <div class="time-dot active"></div>
            <span class="time-label">H6-7: 5:00–7:00</span>
            <div class="time-content">
              <div class="time-content-title">Privilege Escalation</div>
              <div class="time-content-detail">Run LinPEAS/WinPEAS on compromised host. Find and exploit privesc path. Document thoroughly.</div>
              <code class="time-content-cmd">./linpeas.sh | tee /tmp/linpeas.txt</code>
            </div>
          </div>
          <div class="time-block">
            <div class="time-dot crit"></div>
            <span class="time-label">H8: 7:00–8:00</span>
            <div class="time-content">
              <div class="time-content-title">Report Writing Sprint</div>
              <div class="time-content-detail">Write 2 complete findings from today's work. Include: title, CVSS, PoC, impact, remediation.</div>
            </div>
          </div>
          <div class="checklist">
            <div class="schedule-title" style="margin-top:1rem;">// DAY 1 CHECKLIST</div>
            <label class="check-item"><input type="checkbox"> Nmap results documented with service versions</label>
            <label class="check-item"><input type="checkbox"> All web surfaces enumerated (dirs, vhosts, params)</label>
            <label class="check-item"><input type="checkbox"> At least 1 host fully compromised</label>
            <label class="check-item"><input type="checkbox"> Privilege escalation achieved on compromised host</label>
            <label class="check-item"><input type="checkbox"> 2 findings written in report format</label>
          </div>
        </div>
        <div class="targets-col">
          <div class="schedule-title">// TODAY'S TARGETS</div>
          <div class="timer-display">
            <div class="timer-value" id="d1-timer">08:00:00</div>
            <div class="timer-label">// SESSION TIMER</div>
            <div class="timer-btns">
              <button class="timer-btn" onclick="startTimer('d1-timer')">Start</button>
              <button class="timer-btn" onclick="resetTimer('d1-timer', 8)">Reset</button>
            </div>
          </div>
          <div class="target-box">
            <div class="target-ip">10.10.10.101</div>
            <div class="target-name">WEB-01 (Linux)</div>
            <div class="target-detail">Apache 2.4, PHP, MySQL. Custom CMS with upload functionality.</div>
            <div class="target-flags"><span class="target-flag">HTTP:80</span><span class="target-flag">SSH:22</span><span class="target-flag">FTP:21</span></div>
          </div>
          <div class="target-box">
            <div class="target-ip">10.10.10.102</div>
            <div class="target-name">WEB-02 (Linux)</div>
            <div class="target-detail">Nginx, Python Flask API. JWT authentication. Potential IDOR.</div>
            <div class="target-flags"><span class="target-flag">HTTP:80</span><span class="target-flag">HTTPS:443</span><span class="target-flag">SSH:22</span></div>
          </div>
          <div class="target-box">
            <div class="target-ip">10.10.10.103</div>
            <div class="target-name">BACKUP-01 (Linux)</div>
            <div class="target-detail">FTP anonymous allowed. NFS exports. Old backup files in shares.</div>
            <div class="target-flags"><span class="target-flag">FTP:21</span><span class="target-flag">NFS:2049</span><span class="target-flag">SSH:22</span></div>
          </div>
          <div class="target-box">
            <div class="target-ip">10.10.10.104</div>
            <div class="target-name">WIN-01 (Windows 10)</div>
            <div class="target-detail">IIS 10, WinRM enabled. MSSQL Express on non-standard port.</div>
            <div class="target-flags"><span class="target-flag">HTTP:80</span><span class="target-flag">WinRM:5985</span><span class="target-flag">MSSQL:1433</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- DAY 2 -->
  <div class="day-card" id="day2">
    <div class="day-header" onclick="toggleDay('day2')">
      <span class="day-num">DAY 2</span>
      <div class="day-title">
        <div class="day-title-main">Active Directory Assault</div>
        <div class="day-title-sub">Focus: Domain enumeration → Kerberoasting → ACL abuse → DA</div>
      </div>
      <div class="day-meta">
        <span class="meta-pill mp-duration">8 hours</span>
        <span class="meta-pill mp-boxes">AD Lab</span>
      </div>
      <span class="day-chevron">▶</span>
    </div>
    <div class="day-body">
      <div class="day-layout">
        <div class="schedule-col">
          <div class="schedule-title">// HOUR-BY-HOUR SCHEDULE</div>
          <div class="time-block">
            <div class="time-dot active"></div>
            <span class="time-label">H1: 0:00–1:00</span>
            <div class="time-content">
              <div class="time-content-title">BloodHound Collection</div>
              <div class="time-content-detail">Run BloodHound.py with all collection methods. Also run GetUserSPNs, GetNPUsers in parallel.</div>
              <code class="time-content-cmd">bloodhound-python -u user -p pass -d corp.local -c All --zip -dc-ip DC_IP</code>
            </div>
          </div>
          <div class="time-block">
            <div class="time-dot active"></div>
            <span class="time-label">H2: 1:00–2:00</span>
            <div class="time-content">
              <div class="time-content-title">BloodHound Analysis</div>
              <div class="time-content-detail">Import data. Find shortest paths from your user to DA. Identify Kerberoastable + AS-REP targets. Mark owned accounts.</div>
            </div>
          </div>
          <div class="time-block">
            <div class="time-dot active"></div>
            <span class="time-label">H3-4: 2:00–4:00</span>
            <div class="time-content">
              <div class="time-content-title">Kerberoasting + Cracking</div>
              <div class="time-content-detail">Extract all SPNs, crack with hashcat. For each cracked account, check BloodHound for new paths. Run ADCS enum.</div>
              <code class="time-content-cmd">hashcat -m 13100 spns.txt rockyou.txt -r /usr/share/hashcat/rules/best64.rule</code>
            </div>
          </div>
          <div class="time-block">
            <div class="time-dot warn"></div>
            <span class="time-label">H5: 4:00–5:00</span>
            <div class="time-content">
              <div class="time-content-title">BREAK + Pivot Planning</div>
              <div class="time-content-detail">Map out the full attack chain on paper. What's your current access? What's the next step to DA?</div>
            </div>
          </div>
          <div class="time-block">
            <div class="time-dot active"></div>
            <span class="time-label">H6-7: 5:00–7:00</span>
            <div class="time-content">
              <div class="time-content-title">ACL Abuse / ADCS / DA Path</div>
              <div class="time-content-detail">Execute the attack chain. If stuck, try alternate path (AS-REP, ADCS, Pass-the-Hash). Goal: DCSync.</div>
              <code class="time-content-cmd">impacket-secretsdump corp.local/admin@DC_IP -just-dc-ntlm</code>
            </div>
          </div>
          <div class="time-block">
            <div class="time-dot crit"></div>
            <span class="time-label">H8: 7:00–8:00</span>
            <div class="time-content">
              <div class="time-content-title">Document DA Access + Write Findings</div>
              <div class="time-content-detail">Screenshot DA access (C$ share, whoami on DC). Write 3 AD findings: Kerberoastable accounts, path taken, DCSync.</div>
            </div>
          </div>
          <div class="checklist">
            <div class="schedule-title" style="margin-top:1rem;">// DAY 2 CHECKLIST</div>
            <label class="check-item"><input type="checkbox"> BloodHound data collected and imported</label>
            <label class="check-item"><input type="checkbox"> All Kerberoastable SPNs extracted and cracking attempted</label>
            <label class="check-item"><input type="checkbox"> AS-REP roastable accounts checked</label>
            <label class="check-item"><input type="checkbox"> ADCS enumerated with certipy find</label>
            <label class="check-item"><input type="checkbox"> Domain Admin access achieved</label>
            <label class="check-item"><input type="checkbox"> DCSync performed — all hashes dumped</label>
            <label class="check-item"><input type="checkbox"> 3 AD findings written in report format</label>
          </div>
        </div>
        <div class="targets-col">
          <div class="schedule-title">// AD ENVIRONMENT</div>
          <div class="timer-display">
            <div class="timer-value" id="d2-timer">08:00:00</div>
            <div class="timer-label">// SESSION TIMER</div>
            <div class="timer-btns">
              <button class="timer-btn" onclick="startTimer('d2-timer')">Start</button>
              <button class="timer-btn" onclick="resetTimer('d2-timer', 8)">Reset</button>
            </div>
          </div>
          <div class="target-box">
            <div class="target-ip">10.10.10.5</div>
            <div class="target-name">DC01.CORP.LOCAL (DC)</div>
            <div class="target-detail">Windows Server 2019. ADCS installed. 3 Kerberoastable service accounts. 1 AS-REP roastable user.</div>
            <div class="target-flags"><span class="target-flag">LDAP:389</span><span class="target-flag">SMB:445</span><span class="target-flag">ADCS</span></div>
          </div>
          <div class="target-box">
            <div class="target-ip">10.10.10.10</div>
            <div class="target-name">FS01.CORP.LOCAL (File Server)</div>
            <div class="target-detail">Windows Server 2016. SMB shares. Helpdesk group has GenericWrite on IT_MANAGERS.</div>
            <div class="target-flags"><span class="target-flag">SMB:445</span><span class="target-flag">WinRM:5985</span></div>
          </div>
          <div class="target-box">
            <div class="target-ip">Initial Creds</div>
            <div class="target-name">jdoe / Welcome1</div>
            <div class="target-detail">Low-privilege domain user. Member of Domain Users only. Starting point for all enumeration.</div>
            <div class="target-flags"><span class="target-flag">domain user</span><span class="target-flag">no special groups</span></div>
          </div>
          <div class="target-box">
            <div class="target-ip">Hint: Attack Path</div>
            <div class="target-name">Hidden Path Available</div>
            <div class="target-detail">There are 2 paths to DA. One via Kerberoasting + ACL chain. One via ADCS ESC1. Try to find both without hints.</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- DAY 3 -->
  <div class="day-card" id="day3">
    <div class="day-header" onclick="toggleDay('day3')">
      <span class="day-num">DAY 3</span>
      <div class="day-title">
        <div class="day-title-main">Web Application Deep Dive</div>
        <div class="day-title-sub">Focus: SQLi, XSS, file upload, SSRF, IDOR — multi-vuln web app</div>
      </div>
      <div class="day-meta">
        <span class="meta-pill mp-duration">8 hours</span>
        <span class="meta-pill mp-boxes">2 web apps</span>
      </div>
      <span class="day-chevron">▶</span>
    </div>
    <div class="day-body">
      <div class="day-layout">
        <div class="schedule-col">
          <div class="schedule-title">// HOUR-BY-HOUR SCHEDULE</div>
          <div class="time-block">
            <div class="time-dot active"></div>
            <span class="time-label">H1: 0:00–1:00</span>
            <div class="time-content">
              <div class="time-content-title">Manual Recon + Burp Setup</div>
              <div class="time-content-detail">Proxy all traffic through Burp. Map every endpoint, parameter, function manually. No automated scanning yet.</div>
            </div>
          </div>
          <div class="time-block">
            <div class="time-dot active"></div>
