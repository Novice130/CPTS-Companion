<% const pageTitle = 'Deep-Dive Research Hub'; %>
<% const metaDesc = 'Advanced CPTS research: BloodHound queries, AD CS ESC1-8, Ligolo-ng pivoting, RBCD, Potato attacks, Certipy, Shadow Credentials, and more.'; %>
<% const ogPath = '/research'; %>
<%- contentFor('body') %>

<style>
.research-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; margin-top: 1.5rem; }
.research-card { background: var(--htb-surface); border: 1px solid var(--htb-border); border-radius: 10px; padding: 1.25rem; text-decoration: none; display: block; transition: border-color 0.2s, transform 0.15s; position: relative; overflow: hidden; }
.research-card:hover { border-color: var(--htb-green); transform: translateY(-2px); }
.research-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--htb-green); transform: scaleX(0); transition: transform 0.2s; transform-origin: left; }
.research-card:hover::before { transform: scaleX(1); }
.rc-tag { display: inline-block; font-size: 0.65rem; font-family: var(--font-mono); padding: 2px 8px; border-radius: 4px; margin-bottom: 0.75rem; }
.rc-tag.ad { background: rgba(127,209,100,0.12); color: var(--htb-green); border: 1px solid rgba(127,209,100,0.3); }
.rc-tag.web { background: rgba(96,165,250,0.12); color: #60a5fa; border: 1px solid rgba(96,165,250,0.3); }
.rc-tag.priv { background: rgba(251,146,60,0.12); color: #fb923c; border: 1px solid rgba(251,146,60,0.3); }
.rc-tag.evasion { background: rgba(167,139,250,0.12); color: #a78bfa; border: 1px solid rgba(167,139,250,0.3); }
.rc-tag.tools { background: rgba(244,63,94,0.12); color: #f43f5e; border: 1px solid rgba(244,63,94,0.3); }
.rc-title { font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.4rem; font-family: var(--font-mono); }
.rc-desc { font-size: 0.78rem; color: var(--text-muted); line-height: 1.5; }
.rc-arrow { position: absolute; bottom: 1rem; right: 1rem; color: var(--htb-green); font-size: 0.85rem; opacity: 0; transition: opacity 0.2s; }
.research-card:hover .rc-arrow { opacity: 1; }
.research-filter { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem; }
.filter-btn { font-size: 0.72rem; font-family: var(--font-mono); padding: 4px 12px; border-radius: 20px; border: 1px solid var(--htb-border); background: transparent; color: var(--text-muted); cursor: pointer; transition: all 0.2s; }
.filter-btn:hover, .filter-btn.active { border-color: var(--htb-green); color: var(--htb-green); background: rgba(127,209,100,0.08); }
</style>

<div class="page-header" style="margin-bottom: 1.5rem;">
  <h1 class="page-title"><span style="color:var(--htb-green)">></span> Deep-Dive Research Hub</h1>
  <p class="page-subtitle">Advanced attack chains, tool guides, and techniques beyond the standard modules. 15 topics covering the hardest CPTS exam concepts.</p>
</div>

<div class="research-filter">
  <button class="filter-btn active" onclick="filterTopics('all')">All (15)</button>
  <button class="filter-btn" onclick="filterTopics('ad')">Active Directory</button>
  <button class="filter-btn" onclick="filterTopics('priv')">Privilege Escalation</button>
  <button class="filter-btn" onclick="filterTopics('tools')">Tools & Setup</button>
  <button class="filter-btn" onclick="filterTopics('evasion')">Evasion</button>
  <button class="filter-btn" onclick="filterTopics('web')">Web / Infra</button>
</div>

<div class="research-grid" id="researchGrid">
  <a href="/research/bloodhound" class="research-card" data-cat="ad">
    <div class="rc-tag ad">Active Directory</div>
    <div class="rc-title">BloodHound Advanced Queries</div>
    <div class="rc-desc">Custom Cypher queries, shortest path to DA, Kerberoastable + DCSync targets, LAPS + GPO abuse paths.</div>
    <span class="rc-arrow">→</span>
  </a>
  <a href="/research/ligolo-ng" class="research-card" data-cat="ad">
    <div class="rc-tag ad">Active Directory</div>
