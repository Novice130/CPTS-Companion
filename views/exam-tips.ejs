.tip-card:hover { border-color: var(--htb-green); transform: translateY(-2px); }
.tip-card.critical { border-left: 3px solid var(--htb-red); }
.tip-card.important { border-left: 3px solid var(--htb-orange, #f59e0b); }
.tip-card.good { border-left: 3px solid var(--htb-green); }
.tip-number { font-size: 0.7rem; font-family: var(--font-mono); color: var(--text-muted); background: var(--htb-bg); padding: 2px 8px; border-radius: 4px; display: inline-block; margin-bottom: 0.5rem; }
.tip-category { font-size: 0.65rem; font-family: var(--font-mono); color: var(--htb-green); text-transform: uppercase; letter-spacing: 1px; float: right; margin-top: 2px; }
.tip-title { font-size: 0.95rem; font-weight: 600; color: var(--text-primary); margin: 0.4rem 0 0.6rem; }
