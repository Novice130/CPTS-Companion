<% const pageTitle = 'Exam Tips'; %>


<div class="page-header">
  <h1 class="page-title"><span style="color:var(--htb-green)">></span> CPTS Exam Tips</h1>
  <p class="page-subtitle">25 battle-tested strategies from CPTS passers. Read these before exam day.</p>
</div>

<style>
