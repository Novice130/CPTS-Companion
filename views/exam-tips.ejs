.tip-body code { background: var(--htb-bg); padding: 1px 5px; border-radius: 3px; font-family: var(--font-mono); font-size: 0.8rem; color: var(--htb-green); }
.section-title { font-size: 1.1rem; font-family: var(--font-mono); color: var(--htb-green); margin: 2rem 0 0.75rem; padding-left: 0.5rem; border-left: 3px solid var(--htb-green); }
