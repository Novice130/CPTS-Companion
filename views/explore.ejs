<% const pageTitle = 'Explore the CPTS Knowledge Map'; %>
<link rel="stylesheet" href="/css/mindmap-interactive.css">

<div class="explore-container" id="exploreContainer">
  <!-- Toolbar -->
  <div class="explore-toolbar" id="exploreToolbar">
    <div class="toolbar-left">
      <div class="search-box">
        <span class="search-icon">></span>
        <input type="text" id="mapSearch" placeholder="Search nodes..." autocomplete="off" spellcheck="false">
        <kbd class="search-kbd">/</kbd>
      </div>
    </div>

    <div class="toolbar-center">
      <h2 class="toolbar-title">CPTS Knowledge Map</h2>
    </div>

    <div class="toolbar-right">
      <div class="toolbar-group">
        <label class="toolbar-toggle">
          <input type="checkbox" id="filterBeginner" checked>
          <span class="toggle-chip beginner">Beginner</span>
        </label>
        <label class="toolbar-toggle">
          <input type="checkbox" id="filterIntermediate" checked>
          <span class="toggle-chip intermediate">Intermediate</span>
        </label>
        <label class="toolbar-toggle">
          <input type="checkbox" id="filterAdvanced" checked>
          <span class="toggle-chip advanced">Advanced</span>
        </label>
      </div>

      <div class="toolbar-divider"></div>

      <% if (typeof user !== 'undefined' && user) { %>
      <label class="toolbar-toggle">
        <input type="checkbox" id="showProgress">
        <span class="toggle-chip progress-chip">Show Progress</span>
      </label>
      <% } %>

      <label class="toolbar-toggle">
        <input type="checkbox" id="showPrereqs">
        <span class="toggle-chip prereq-chip">Prerequisites</span>
      </label>

      <button class="toolbar-btn" id="resetZoom" title="Reset zoom">
        <span>[ ]</span>
      </button>

      <button class="toolbar-btn" id="exportPng" title="Export as PNG">
        <span>PNG</span>
      </button>
    </div>
  </div>

  <!-- Main Graph Area -->
  <div class="graph-viewport" id="graphViewport">
    <svg id="graphSvg" width="100%" height="100%">
      <defs>
        <filter id="nodeGlow">
          <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
          <feMerge><feMergeNode in="coloredBlur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
        <marker id="arrowhead" viewBox="0 0 10 10" refX="20" refY="5"
                markerWidth="6" markerHeight="6" orient="auto-start-reverse"
                fill="#30363d">
          <path d="M 0 0 L 10 5 L 0 10 z"/>
        </marker>
        <marker id="arrowheadActive" viewBox="0 0 10 10" refX="20" refY="5"
                markerWidth="6" markerHeight="6" orient="auto-start-reverse"
                fill="#1d9e75">
          <path d="M 0 0 L 10 5 L 0 10 z"/>
        </marker>
      </defs>
      <g id="graphGroup">
        <g id="linksGroup"></g>
        <g id="nodesGroup"></g>
      </g>
    </svg>

    <!-- Minimap -->
    <div class="minimap" id="minimap">
      <canvas id="minimapCanvas" width="200" height="140"></canvas>
      <div class="minimap-viewport" id="minimapViewport"></div>
    </div>
  </div>

  <!-- Detail Panel (slides in from right) -->
  <div class="detail-panel" id="detailPanel">
    <button class="detail-close" id="detailClose">&times;</button>
    <div class="detail-header">
      <span class="detail-difficulty" id="detailDifficulty"></span>
      <h3 class="detail-title" id="detailTitle"></h3>
      <p class="detail-branch" id="detailBranch"></p>
    </div>

    <div class="detail-body">
      <div class="detail-section">
        <h4>Description</h4>
        <p id="detailDesc"></p>
      </div>

      <div class="detail-meta">
        <div class="meta-item">
          <span class="meta-label">Est. Study Time</span>
          <span class="meta-value" id="detailTime"></span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Flashcards</span>
          <span class="meta-value" id="detailCards"></span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Exercises</span>
          <span class="meta-value" id="detailExercises"></span>
        </div>
      </div>

      <div class="detail-section" id="detailTechniquesSection">
        <h4>Key Techniques</h4>
        <ul class="detail-techniques" id="detailTechniques"></ul>
      </div>

      <div class="detail-section" id="detailPrereqsSection">
        <h4>Prerequisites</h4>
        <ul class="detail-prereqs" id="detailPrereqs"></ul>
      </div>
    </div>

    <div class="detail-footer">
      <a href="#" class="detail-start-btn" id="detailStartBtn">
        <span>></span> Start Module
      </a>
    </div>
  </div>
</div>

<script src="https://d3js.org/d3.v7.min.js"></script>
<script src="/js/mindmap-interactive.js"></script>
