<% if (!user) { %>
<style>
@keyframes lp-in {
  from { opacity: 0; transform: perspective(900px) rotateX(10deg) translateY(-24px) scale(0.97); }
  to   { opacity: 1; transform: perspective(900px) rotateX(2deg)  translateY(0)      scale(1); }
}
@keyframes lp-overlay-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
#lp-overlay { animation: lp-overlay-in 0.35s ease forwards; }
#lp-card    { animation: lp-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

#lp-badge {
  position: fixed;
  bottom: 1.5rem;
  right: 1.5rem;
  z-index: 9000;
  display: none;
}
#lp-badge a {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  background: var(--htb-surface, #1a1a2e);
  border: 1px solid rgba(127,209,100,0.35);
  color: var(--htb-green, #7fd164);
  text-decoration: none;
  padding: 0.55rem 1rem;
  border-radius: 8px;
  font-size: 0.75rem;
  font-family: var(--font-mono, monospace);
  box-shadow: 0 6px 20px rgba(0,0,0,0.5);
  transition: box-shadow 0.2s, border-color 0.2s;
}
#lp-badge a:hover {
  border-color: rgba(127,209,100,0.7);
  box-shadow: 0 6px 24px rgba(127,209,100,0.15);
}
#lp-badge-close {
  position: absolute;
  top: -7px;
  right: -7px;
  width: 18px;
  height: 18px;
  background: var(--htb-surface, #1a1a2e);
  border: 1px solid var(--htb-border, #333);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 0.6rem;
  color: var(--text-muted, #888);
  line-height: 1;
}
#lp-badge-close:hover { color: #fff; }
</style>

<!-- Small persistent badge (shown after popup dismissed) -->
<div id="lp-badge">
  <a href="/login">🔒 Login to save progress</a>
  <div id="lp-badge-close" onclick="document.getElementById('lp-badge').style.display='none'" title="Dismiss">✕</div>
</div>

<!-- Full screen overlay + 3D card popup -->
<div id="lp-overlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.78); backdrop-filter:blur(7px); z-index:10000; align-items:center; justify-content:center;">
  <div id="lp-card" style="
    background: linear-gradient(160deg, #1c1c2e 0%, #141422 100%);
    border: 1px solid rgba(127,209,100,0.18);
    border-radius: 16px;
    padding: 2.75rem 2.5rem 2.25rem;
    max-width: 420px;
    width: 90%;
    text-align: center;
    box-shadow:
      0 40px 80px rgba(0,0,0,0.85),
      0 20px 40px rgba(0,0,0,0.6),
      0 0 0 1px rgba(127,209,100,0.08),
      inset 0 1px 0 rgba(255,255,255,0.06);
    position: relative;
  ">
    <!-- Green top accent line -->
    <div style="position:absolute; top:0; left:12%; right:12%; height:2px; background:linear-gradient(90deg, transparent, rgba(127,209,100,0.6), transparent); border-radius:999px;"></div>

    <div style="font-size:2.8rem; margin-bottom:1rem; line-height:1;">🔐</div>
    <h2 style="color:#fff; font-size:1.2rem; font-weight:700; margin:0 0 0.75rem; letter-spacing:-0.01em;">Save Your Progress</h2>
    <p style="color:rgba(255,255,255,0.5); font-size:0.84rem; line-height:1.65; margin:0 0 2rem;">
      You're exploring as a guest. Log in to save your study plan, flashcard reviews, exercise progress, and notes — all synced across devices.
    </p>

    <div style="display:flex; gap:0.75rem; justify-content:center; flex-wrap:wrap;">
      <button onclick="lpDismiss()" style="
        background: transparent;
        color: rgba(255,255,255,0.45);
        border: 1px solid rgba(255,255,255,0.12);
        padding: 0.65rem 1.4rem;
        border-radius: 8px;
        cursor: pointer;
        font-size: 0.83rem;
        transition: all 0.2s;
        font-family: inherit;
      " onmouseover="this.style.borderColor='rgba(255,255,255,0.25)';this.style.color='rgba(255,255,255,0.65)'" onmouseout="this.style.borderColor='rgba(255,255,255,0.12)';this.style.color='rgba(255,255,255,0.45)'">
        Continue as Guest
      </button>
      <a href="/login" style="
        background: #7fd164;
        color: #0a0a0a;
        text-decoration: none;
        padding: 0.65rem 1.6rem;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.83rem;
        letter-spacing: 0.01em;
        transition: all 0.2s;
        box-shadow: 0 0 20px rgba(127,209,100,0.3), 0 4px 12px rgba(0,0,0,0.3);
        display: inline-block;
      " onmouseover="this.style.background='#8fe873';this.style.boxShadow='0 0 28px rgba(127,209,100,0.45), 0 4px 12px rgba(0,0,0,0.3)'" onmouseout="this.style.background='#7fd164';this.style.boxShadow='0 0 20px rgba(127,209,100,0.3), 0 4px 12px rgba(0,0,0,0.3)'">
        Sign In
      </a>
    </div>

    <p style="margin:1.5rem 0 0; font-size:0.72rem; color:rgba(255,255,255,0.22); font-family:var(--font-mono, monospace);">
      // No account required to explore content
    </p>
  </div>
</div>

<script>
(function() {
  var STORAGE_KEY = 'cpts_login_prompt_seen';

  function lpShowBadge() {
    var badge = document.getElementById('lp-badge');
    if (badge) badge.style.display = 'block';
  }

  function lpHideOverlay() {
    var overlay = document.getElementById('lp-overlay');
    if (overlay) {
      overlay.style.opacity = '0';
      overlay.style.transition = 'opacity 0.3s ease';
      setTimeout(function() { overlay.style.display = 'none'; }, 300);
    }
  }

  window.lpDismiss = function() {
    try { localStorage.setItem(STORAGE_KEY, '1'); } catch(e) {}
    lpHideOverlay();
    lpShowBadge();
  };

  // Check if already seen
  var alreadySeen = false;
  try { alreadySeen = !!localStorage.getItem(STORAGE_KEY); } catch(e) {}

  if (alreadySeen) {
    // Just show the small badge, never show popup again
    document.addEventListener('DOMContentLoaded', lpShowBadge);
  } else {
    // Show popup once, 1.8s after load
    document.addEventListener('DOMContentLoaded', function() {
      setTimeout(function() {
        var overlay = document.getElementById('lp-overlay');
        if (overlay) overlay.style.display = 'flex';
      }, 1800);
    });
  }
})();
</script>
<% } %>
